# voice_ai_web settings (optional: config.json has the same values; these win). No secrets here.

# Page ports: http for this machine (localhost), https for other computers (the microphone needs https off localhost)
# PORT=8323
# HTTPS_PORT=8443
# HTTPS=off            turn https off

# Where voice_ai_backend runs. Every /api/* request is forwarded there.
# BACKEND_URL=http://127.0.0.1:8324

# HTTPS certificate (made by scripts/make-cert.sh, which run.sh runs). Use your own trusted certificate in production:
# HTTPS_CERT=certs/server.crt
# HTTPS_KEY=certs/server.key
