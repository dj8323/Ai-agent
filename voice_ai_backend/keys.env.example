# voice_ai_backend — keys for the extra speech providers and message channels.
#
#   cp keys.env.example keys.env      then fill in the keys you use; keys.env is never committed (.gitignore)
#
# The backend reads keys.env next to .env (both optional files; Spring property names, KEY=VALUE). Leave a key empty
# and that provider / channel stays switched off. OPENAI_API_KEY and the MySQL login stay in .env.
# These integrations are planned: the keys are read, the code that uses them comes next.

# ---------- Amazon: Transcribe (speech-to-text) + Polly (text-to-speech) ----------
# IAM user with transcribe:StartStreamTranscription (+ StartTranscriptionJob) and polly:SynthesizeSpeech
aws.access-key=
aws.secret-key=
# Mumbai = ap-south-1 (both Transcribe streaming and Polly neural voices are available there)
aws.region=ap-south-1

# ---------- ElevenLabs: Scribe (speech-to-text) + voices (text-to-speech) ----------
# https://elevenlabs.io/app/settings/api-keys
elevenlabs.api-key=
# optional: default voice id (from the ElevenLabs voice library) and model
elevenlabs.voice-id=
elevenlabs.model=eleven_flash_v2_5

# ---------- Cartesia Sonic (text-to-speech) ----------
# https://play.cartesia.ai/keys
cartesia.api-key=
# optional: default voice id and model
cartesia.voice-id=
cartesia.model=sonic-2

# ---------- Email (call summaries, emergency alerts) ----------
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=
# Gmail / Google Workspace: an App Password (not the account password)
spring.mail.password=
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
# shown as the sender, e.g. "TelemuneSmartAi <support@company.com>"
mail.from=

# ---------- WhatsApp: Telemune WhatsApp gateway (template messages) ----------
# Same gateway as VoiceAIBackend (CallSummaryNotifier / WhatsAppSender). Messages go out as approved templates.
whatsapp.enabled=true
whatsapp.base-url=https://tryai.telemune.com/whatsappApi
whatsapp.send-path=/sendTextWhatsApp
whatsapp.template-send-path=/sendWhatsApp
# call summaries: first contact template, the summary template, and the reply text
whatsapp.connect-template=get_summaries
whatsapp.summary-template=ai_message_summary
whatsapp.summary-reply=Thanks
# emergency alerts: a separate gateway instance (falls back to whatsapp.base-url when empty)
whatsapp.emergency-base-url=https://tryai.telemune.com/whatsappApi
whatsapp.emergency-template=emergency_alert_new

# ---------- Flash SMS (planned for later; leave empty) ----------
# class 0 SMS that pops up on the screen. India: DLT registration (entity id + approved template ids).
sms.enabled=false
sms.api-url=
sms.api-key=
sms.sender-id=
sms.dlt-entity-id=
sms.dlt-template.summary=
