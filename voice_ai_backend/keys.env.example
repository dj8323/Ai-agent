# voice_ai_backend — keys for the extra speech providers and message channels.
#
#   cp keys.env.example keys.env      then fill in the keys you use; keys.env is never committed (.gitignore)
#
# The backend reads keys.env next to .env (both optional files, same KEY=VALUE format). Leave a key empty and that
# provider / channel stays switched off. OPENAI_API_KEY and the MySQL login stay in .env.
# These integrations are planned: the keys are read, the code that uses them comes next.

# ---------- Speech-to-text (STT) ----------
# ElevenLabs Scribe          https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Amazon Transcribe (and Polly below) — an IAM user with transcribe:* and polly:SynthesizeSpeech
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

# ---------- Text-to-speech (TTS) ----------
# ElevenLabs uses ELEVENLABS_API_KEY above; Amazon Polly uses the AWS keys above.
# Cartesia Sonic             https://play.cartesia.ai/keys
CARTESIA_API_KEY=

# ---------- Emergency contacts and call summaries ----------
# WhatsApp (Meta WhatsApp Cloud API)   https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Flash SMS (class 0 SMS that pops up on the screen) — your SMS gateway
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=
