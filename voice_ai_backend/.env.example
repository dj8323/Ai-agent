# voice_ai_backend settings. Copy to .env and fill in. Secrets live only here; app settings live in MySQL (app_config).

# OpenAI key from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# MySQL 8 (the database and all tables are created on first start)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=ai-agent

# Where the API listens. 127.0.0.1 = only this machine (the web app runs here too).
# Use 0.0.0.0 when voice_ai_web runs on another server, and allow only that server in the firewall.
BACKEND_PORT=8324
BACKEND_HOST=127.0.0.1

# Logging: logs/backend.log (everything) + logs/error.log (problems). DEBUG = full detail, INFO = less.
# See Troubleshooting.md. Admins can also change levels live: PUT /api/admin/log-level.
LOG_LEVEL=DEBUG
SQL_LOG=DEBUG
# LOG_DIR=logs

# Optional overrides
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_REASONING_EFFORT=
# APP_HOME=.          folder holding config.json and data/ (default: this folder)

# Extra voice_ai_web server addresses whose X-Forwarded-For (caller IP) is trusted, comma separated
# TRUSTED_PROXIES=10.0.0.5

# SuperAdmin (role 0): set these two, restart, sign in and change the password, then delete SUPERADMIN_PASSWORD.
# An existing username is promoted to SuperAdmin; a new one is created. See README → SuperAdmin.
SUPERADMIN_USERNAME=
SUPERADMIN_PASSWORD=
