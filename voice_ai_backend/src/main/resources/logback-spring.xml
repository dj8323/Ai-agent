<?xml version="1.0" encoding="UTF-8"?>
<!--
  TelemuneSmartAi backend logging: two files in logs/ (LOG_DIR in .env changes the folder).

    backend.log  everything: start-up, every API request, sign-ins, user actions, OpenAI calls with timings,
                 and at DEBUG the details (caller's words, agent's replies, every SQL statement).   kept 14 days
    error.log    WARN and up only (also in backend.log): the first place to look when something breaks. kept 60 days

  Every line: time (UTC, like the database) · level · [request id] · [user] · [agent id] · logger · message.
  The request id is also sent back in the X-Request-Id header and stored in api_logs.request_id and
  activity_logs.request_id, so one id finds a request in the logs and in MySQL.

  Levels (in .env, then restart): LOG_LEVEL=DEBUG (default) or INFO (no detail lines);
  SQL_LOG=DEBUG (default) or INFO (no SQL lines). Admins can also change them live: PUT /api/admin/log-level.
  Nothing is printed to the console (run.sh sends anything the JVM prints itself to error.log).
-->
<configuration>
  <springProperty scope="context" name="LOG_DIR" source="LOG_DIR" defaultValue="logs"/>
  <springProperty scope="context" name="LOG_LEVEL" source="LOG_LEVEL" defaultValue="DEBUG"/>
  <springProperty scope="context" name="SQL_LOG" source="SQL_LOG" defaultValue="DEBUG"/>

  <property name="PATTERN"
            value="%d{yyyy-MM-dd HH:mm:ss.SSS,UTC}Z %-5level [%X{reqId:--}] [%X{user:--}] [%X{agent:--}] %logger{1} - %msg%n%ex{full}"/>

  <appender name="BACKEND" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_DIR}/backend.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <fileNamePattern>${LOG_DIR}/archive/backend.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
      <maxFileSize>100MB</maxFileSize><maxHistory>14</maxHistory><totalSizeCap>5GB</totalSizeCap>
    </rollingPolicy>
    <encoder><pattern>${PATTERN}</pattern><charset>UTF-8</charset></encoder>
  </appender>

  <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_DIR}/error.log</file>
    <filter class="ch.qos.logback.classic.filter.ThresholdFilter"><level>WARN</level></filter>
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <fileNamePattern>${LOG_DIR}/archive/error.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
      <maxFileSize>50MB</maxFileSize><maxHistory>60</maxHistory><totalSizeCap>1GB</totalSizeCap>
    </rollingPolicy>
    <encoder><pattern>${PATTERN}</pattern><charset>UTF-8</charset></encoder>
  </appender>

  <!-- Our code. -->
  <logger name="com.telemune" level="${LOG_LEVEL}"/>
  <!-- SQL statements (logger "SQL"): into backend.log like everything else, own level. -->
  <logger name="SQL" level="${SQL_LOG}"/>
  <!-- Frameworks: start-up line and problems only. -->
  <logger name="org.springframework.boot.web.embedded.tomcat" level="INFO"/>
  <logger name="org.springframework.boot.StartupInfoLogger" level="INFO"/>
  <logger name="com.zaxxer.hikari" level="INFO"/>

  <root level="WARN">
    <appender-ref ref="BACKEND"/>
    <appender-ref ref="ERROR_FILE"/>
  </root>
</configuration>
