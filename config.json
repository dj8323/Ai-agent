{
  "server": {
    "port": 8323,
    "httpsPort": 8443
  },
  "branding": {
    "appName": "TelemuneSmartAi",
    "tagline": "Talk naturally, get things done ⚡",
    "logo": "telemune-mark.png",
    "favicon": "telemune-logo.svg",
    "footer": "Powered by Telemune © 2027 · Designed by DJ",
    "theme": {
      "primary": "#7c3aed",
      "secondary": "#ec4899",
      "tertiary": "#06b6d4"
    }
  },
  "agent": {
    "defaultName": "Riya",
    "defaultLanguage": "en-US",
    "defaultVoice": "cedar",
    "maxReplyWords": 25,
    "defaultPlaybookId": ""
  },
  "models": {
    "chat": "gpt-4.1-mini",
    "tts": "gpt-4o-mini-tts",
    "reasoningEffort": "none",
    "maxReplyTokens": 1024,
    "maxSummaryTokens": 2048
  },
  "speechToText": {
    "engine": "openai",
    "model": "gpt-4o-transcribe",
    "vadThreshold": 0.015,
    "minSpeechMs": 250,
    "maxUtteranceSeconds": 60
  },
  "conversation": {
    "responseDelayMs": 1000,
    "hangupDelayMs": 800,
    "historyTurnsSentToModel": 30,
    "silenceRetrySeconds": 8,
    "silenceRetries": 2
  },
  "history": {
    "pageSize": 5,
    "maxRecordingMB": 100
  },
  "calendar": {
    "enabled": true,
    "defaultDurationMin": 30
  },
  "emergency": {
    "enabled": false,
    "rules": []
  }
}
