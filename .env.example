# Copy to .env and fill in. Secrets only; app settings live in the MySQL table app_config.
# OpenAI key from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# MySQL (the database and tables are created on first start)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=ai-agent
